class Solution:
    def minimumCost(self, cost: List[int]) -> int:
        if len(cost) <= 2:
            return sum(cost)
        
        num = 0
        cost.sort(reverse = True)
        for i in range(1,len(cost)+1):
            if i % 3 == 0:
                pass
            else:
                num += cost[i-1]
        return num
